<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless UI tests: the real windows rendered with Skia, screenshots saved for review. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Avalonia.Headless.XUnit 12 is built on xunit v3, whose test projects are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CharTaiko.App/CharTaiko.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
