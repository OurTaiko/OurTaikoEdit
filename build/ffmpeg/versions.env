# Every source the ffmpeg package is built from: exact version, where it comes from, and its SHA-256.
# build.sh refuses a download whose hash differs. Plain shell assignments (sourced by build.sh and the
# workflow). <NAME>_FILE is the name the tarball is stored under (in the download cache and in source/).
#
# Changing anything here changes the release: bump FFMPEG_VERSION or the workflow's build number.

# FFmpeg 9.1 "Gauss", the latest stable release on https://ffmpeg.org/releases/ as of 2026-11-20.
FFMPEG_VERSION=9.1
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.1.tar.xz
FFMPEG_FILE=ffmpeg-9.1.tar.xz
FFMPEG_SHA256=1a4d394ae63d190a526cd052eb4415c156b5c5e2df37efab41a7de0b8fde2433

# zlib (PNG, compressed MOV headers, Matroska zlib-compressed tracks).
ZLIB_VERSION=1.4
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.4/zlib-1.4.tar.xz
ZLIB_FILE=zlib-1.4.tar.xz
ZLIB_SHA256=4f11c512053d7bab8d9e9b89bde3575add3e4c50a383b42ef6cb837035fc5a7c

# x264 has no releases: the head of its "stable" branch (2025-06-08, "i8mm & neon hpel_filter optimization").
# GitLab generates the archive on request; its hash has been stable, but if it ever changes, check the
# contents against the commit before updating the hash.
X264_VERSION=b35605ace3ddf7c1a5d67a2eb553f034aef41d55
X264_URL=https://code.videolan.org/videolan/x264/-/archive/b35605ace3ddf7c1a5d67a2eb553f034aef41d55/x264-b35605ace3ddf7c1a5d67a2eb553f034aef41d55.tar.bz2
X264_FILE=x264-b35605ace3ddf7c1a5d67a2eb553f034aef41d55.tar.bz2
X264_SHA256=6eeb82934e69fd51e043bd8c5b0d152839638d1ce7aa4eea65a3fedcf83ff224

LAME_VERSION=4.0
LAME_URL=https://downloads.sourceforge.net/project/lame/lame/4.0/lame-4.0.tar.gz
LAME_FILE=lame-4.0.tar.gz
LAME_SHA256=3df5124d5ad3a98312ffd7ba6a9b36230e4f8a3e66d3ce0f425e336c32d216eb

OGG_VERSION=1.3.6
OGG_URL=https://downloads.xiph.org/releases/ogg/libogg-1.3.6.tar.xz
OGG_FILE=libogg-1.3.6.tar.xz
OGG_SHA256=5c8253428e181840cd20d41f3ca16557a9cc04bad4a3d04cce84808677fa1061

VORBIS_VERSION=1.3.7
VORBIS_URL=https://downloads.xiph.org/releases/vorbis/libvorbis-1.3.7.tar.xz
VORBIS_FILE=libvorbis-1.3.7.tar.xz
VORBIS_SHA256=b33cc4934322bcbf6efcbacf49e3ca01aadbea4114ec9589d1b1e9d20f72954b

OPUS_VERSION=1.6.1
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.6.1.tar.gz
OPUS_FILE=opus-1.6.1.tar.gz
OPUS_SHA256=6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1

# GitHub tag archive (libvpx publishes no release tarballs).
VPX_VERSION=1.17.0
VPX_URL=https://github.com/webmproject/libvpx/archive/refs/tags/v1.17.0.tar.gz
VPX_FILE=libvpx-1.17.0.tar.gz
VPX_SHA256=1020f184046187baa2985dbde38e0691f49c44088bca7a1842b0236c6081dc0a

DAV1D_VERSION=1.5.5
DAV1D_URL=https://downloads.videolan.org/pub/videolan/dav1d/1.5.5/dav1d-1.5.5.tar.xz
DAV1D_FILE=dav1d-1.5.5.tar.xz
DAV1D_SHA256=ca96b1d0ba3f01f55de7231d775892b64994ba061aaeeaaa4f662a390b3abf9e

# Build order (each one only needs those before it).
SOURCES="ZLIB X264 LAME OGG VORBIS OPUS VPX DAV1D FFMPEG"
