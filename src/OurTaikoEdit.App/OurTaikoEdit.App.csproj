<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OurTaikoEdit</AssemblyName>
    <RootNamespace>OurTaikoEdit.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\**\*.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../OurTaikoEdit.Core/OurTaikoEdit.Core.csproj" />
    <ProjectReference Include="../OurTaikoEdit.Tja/OurTaikoEdit.Tja.csproj" />
    <ProjectReference Include="../OurTaikoEdit.Audio/OurTaikoEdit.Audio.csproj" />
  </ItemGroup>
  <!-- The mods the app ships with. The app does not reference them: each is built with it and laid
       out as Mods/<ModFolder>/ (its assembly and mod.json) next to the app, in the build output and
       in what is published, where ModRegistry finds it at startup like any other mod. -->
  <ItemGroup>
    <ProjectReference Include="../OurTaikoEdit.Mods.ChartImage/OurTaikoEdit.Mods.ChartImage.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="ShippedMod" ModFolder="ChartImage" />
  </ItemGroup>
  <Target Name="ShipMods" DependsOnTargets="ResolveProjectReferences" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Include="@(ShippedMod)" Link="Mods/%(ShippedMod.ModFolder)/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
      <None Include="@(ShippedMod->'%(RootDir)%(Directory)mod.json')" Link="Mods/%(ShippedMod.ModFolder)/mod.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
