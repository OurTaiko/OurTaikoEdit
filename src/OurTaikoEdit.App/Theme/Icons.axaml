<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Line icons on a 16-unit grid, drawn by Controls/Icon with a 1.5 round pen (the Solid ones
       filled). Drawn for this app. -->
  <StreamGeometry x:Key="IconBack">M9.5 3.5 L5 8 L9.5 12.5</StreamGeometry>
  <StreamGeometry x:Key="IconChevronDown">M3.5 6 L8 10.5 L12.5 6</StreamGeometry>
  <StreamGeometry x:Key="IconChevronUp">M3.5 10 L8 5.5 L12.5 10</StreamGeometry>
  <StreamGeometry x:Key="IconSave">M3.5 2.5 H10.5 L13.5 5.5 V12.5 A1 1 0 0 1 12.5 13.5 H3.5 A1 1 0 0 1 2.5 12.5 V3.5 A1 1 0 0 1 3.5 2.5 Z M5.5 2.5 V5.5 H9.5 V2.5 M5 13.5 V9.5 H11 V13.5</StreamGeometry>
  <StreamGeometry x:Key="IconUndo">M5.5 3.5 L2.5 6.5 L5.5 9.5 M2.5 6.5 H10 A3.5 3.5 0 0 1 10 13.5 H6.5</StreamGeometry>
  <StreamGeometry x:Key="IconRedo">M10.5 3.5 L13.5 6.5 L10.5 9.5 M13.5 6.5 H6 A3.5 3.5 0 0 0 6 13.5 H9.5</StreamGeometry>
  <StreamGeometry x:Key="IconSearch">M11.5 7 A4.5 4.5 0 1 1 2.5 7 A4.5 4.5 0 1 1 11.5 7 Z M10.3 10.3 L13.5 13.5</StreamGeometry>
  <StreamGeometry x:Key="IconFormat">M2.5 4 H13.5 M5.5 8 H13.5 M5.5 12 H10.5 M2.5 7 L4 8 L2.5 9</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M2.5 4.5 H7 M10 4.5 H13.5 M10 4.5 A1.5 1.5 0 1 1 7 4.5 A1.5 1.5 0 1 1 10 4.5 Z M2.5 11.5 H5.5 M8.5 11.5 H13.5 M8.5 11.5 A1.5 1.5 0 1 1 5.5 11.5 A1.5 1.5 0 1 1 8.5 11.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPlus">M8 3 V13 M3 8 H13</StreamGeometry>
  <StreamGeometry x:Key="IconFolder">M2.5 4.5 A1 1 0 0 1 3.5 3.5 H6.2 L7.7 5 H12.5 A1 1 0 0 1 13.5 6 V11.5 A1 1 0 0 1 12.5 12.5 H3.5 A1 1 0 0 1 2.5 11.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M4 4 L12 12 M12 4 L4 12</StreamGeometry>
  <StreamGeometry x:Key="IconVolume">M2.5 6.2 H4.8 L8 3.5 V12.5 L4.8 9.8 H2.5 Z M10.5 6 A2.8 2.8 0 0 1 10.5 10 M12.2 4.2 A5.3 5.3 0 0 1 12.2 11.8</StreamGeometry>
  <StreamGeometry x:Key="IconDrum">M13.5 6 A5.5 2.5 0 1 1 2.5 6 A5.5 2.5 0 1 1 13.5 6 Z M2.5 6 V10.5 A5.5 2.5 0 0 0 13.5 10.5 V6 M5.5 8.2 V12.3 M10.5 8.2 V12.3</StreamGeometry>
  <StreamGeometry x:Key="IconSolidPlay">M4.8 2.9 A0.8 0.8 0 0 1 6 2.2 L13.6 7.3 A0.8 0.8 0 0 1 13.6 8.7 L6 13.8 A0.8 0.8 0 0 1 4.8 13.1 Z</StreamGeometry>
  <StreamGeometry x:Key="IconSolidPause">M4 2.5 H6.5 V13.5 H4 Z M9.5 2.5 H12 V13.5 H9.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconSolidRewind">M3 3 H4.8 V13 H3 Z M13 3.4 A0.6 0.6 0 0 0 12.1 2.9 L6 7.5 A0.6 0.6 0 0 0 6 8.5 L12.1 13.1 A0.6 0.6 0 0 0 13 12.6 Z</StreamGeometry>
</ResourceDictionary>
