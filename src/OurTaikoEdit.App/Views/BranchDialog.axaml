<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OurTaikoEdit.App.Views.BranchDialog"
        xmlns:l="using:OurTaikoEdit.App.Localization"
        Width="500" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="footer">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="accent wide" x:Name="OkButton" Content="{l:T Ok}" IsDefault="True" Click="Accept" />
        <Button Classes="wide" Content="{l:T Cancel}" IsCancel="True" Click="Cancel" />
      </StackPanel>
    </Border>

    <StackPanel Margin="20,18,20,20" Spacing="14">
      <TextBlock Classes="h1" x:Name="Heading" />

      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="{l:T BranchCondition}" />
        <ComboBox x:Name="KindBox" HorizontalAlignment="Stretch" />
        <TextBlock x:Name="KindInfo" Classes="caption" TextWrapping="Wrap" />
        <CheckBox x:Name="BigOnlyBox" />
      </StackPanel>

      <StackPanel Classes="field">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
          <TextBlock Classes="label" Text="{l:T BranchExpert}" />
          <TextBlock Classes="label" Grid.Column="1" Text="{l:T BranchMaster}" />
          <TextBox Grid.Row="1" x:Name="ExpertBox" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="MasterBox" />
        </Grid>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:T BranchRule}" />
        <CheckBox x:Name="LessBox">
          <TextBlock TextWrapping="Wrap" Text="{l:T BranchLess}" />
        </CheckBox>
      </StackPanel>

      <!-- The condition as it will stand in the code -->
      <Border Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
        <TextBlock x:Name="WrittenText" FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource MutedBrush}" />
      </Border>
      <TextBlock x:Name="ErrorText" Classes="error" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>
  </DockPanel>
</Window>
