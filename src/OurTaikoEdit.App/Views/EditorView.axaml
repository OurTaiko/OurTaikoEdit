<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OurTaikoEdit.App.ViewModels"
             xmlns:core="using:OurTaikoEdit.Core.Languages"
             xmlns:ot="using:OurTaiko"
             xmlns:controls="using:OurTaikoEdit.App.Controls"
             xmlns:t="using:OurTaikoEdit.App.Theme"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:l="using:OurTaikoEdit.App.Localization"
             xmlns:loc="using:OurTaikoEdit.Core.Localization"
             x:Class="OurTaikoEdit.App.Views.EditorView"
             x:DataType="vm:EditorViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Meta+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding TogglePlayCommand}" />
    <KeyBinding Gesture="Shift+Alt+F" Command="{Binding FormatDocumentCommand}" />
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- The bar: where you are and the document's actions; playback in the middle; sound and settings. -->
    <Border Classes="bar" Height="44" Padding="8,0">
      <Grid ColumnDefinitions="*,Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="ghost" Command="{Binding BackCommand}">
            <StackPanel>
              <controls:Icon Data="{StaticResource IconBack}" />
              <TextBlock Text="{l:T Projects}" />
            </StackPanel>
          </Button>
          <TextBlock Classes="faint" Text="/" VerticalAlignment="Center" Margin="2,0,8,0" />
          <TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
          <Panel Width="18" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" IsVisible="{Binding IsDirty}" ToolTip.Tip="{l:T UnsavedChanges}" />
          </Panel>
          <Border Classes="vsep" />
          <Button Classes="ghost" Command="{Binding SaveCommand}" ToolTip.Tip="{l:T SaveTip}">
            <StackPanel>
              <controls:Icon Data="{StaticResource IconSave}" />
              <TextBlock Text="{l:T Save}" />
            </StackPanel>
          </Button>
          <Button Classes="ghost icon" x:Name="UndoButton" ToolTip.Tip="{l:T UndoTip}">
            <controls:Icon Data="{StaticResource IconUndo}" />
          </Button>
          <Button Classes="ghost icon" x:Name="RedoButton" ToolTip.Tip="{l:T RedoTip}">
            <controls:Icon Data="{StaticResource IconRedo}" />
          </Button>
          <Border Classes="vsep" />
          <Button Classes="ghost icon" x:Name="FindButton" ToolTip.Tip="{l:T FindTip}">
            <controls:Icon Data="{StaticResource IconSearch}" />
          </Button>
          <Button Classes="ghost icon" Command="{Binding FormatDocumentCommand}" ToolTip.Tip="{l:T FormatTip}">
            <controls:Icon Data="{StaticResource IconFormat}" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="ghost icon" Command="{Binding RewindCommand}" ToolTip.Tip="{l:T RewindTip}">
            <controls:Icon Data="{StaticResource IconSolidRewind}" Filled="True" />
          </Button>
          <Button Classes="accent play" Command="{Binding TogglePlayCommand}" ToolTip.Tip="{l:T PlayTip}">
            <Panel>
              <controls:Icon Data="{StaticResource IconSolidPlay}" Filled="True" IsVisible="{Binding !IsPlaying}" />
              <controls:Icon Data="{StaticResource IconSolidPause}" Filled="True" IsVisible="{Binding IsPlaying}" />
            </Panel>
          </Button>
          <!-- As wide as the rewind button, so the play button sits in the middle. -->
          <Panel Width="28" />
        </StackPanel>

        <!-- (The audio's status gives way first when the window is narrow.) -->
        <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding AudioStatus}" Classes="caption" VerticalAlignment="Center" HorizontalAlignment="Right"
                   TextTrimming="CharacterEllipsis" Margin="12,0,14,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <controls:Icon Data="{StaticResource IconVolume}" TextElement.Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" ToolTip.Tip="{l:T VolumeTip}" />
          <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" Width="84" VerticalAlignment="Center" Margin="4,0,6,0" ToolTip.Tip="{l:T VolumeTip}" />
          <ToggleButton Classes="ghost" IsChecked="{Binding HitSounds}" ToolTip.Tip="{l:T HitsTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <controls:Icon Data="{StaticResource IconDrum}" />
              <TextBlock Text="{l:T Hits}" />
            </StackPanel>
          </ToggleButton>
          <Border Classes="vsep" />
          <Button Classes="ghost icon" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{l:T Settings}">
            <controls:Icon Data="{StaticResource IconSettings}" />
          </Button>
        </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Code on the left; lane over timeline on the right -->
    <Grid Grid.Row="1" ColumnDefinitions="5*,5,6*">
      <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- The chart's difficulties, as the code's tabs -->
        <Border Classes="bar" Height="34">
         <Grid ColumnDefinitions="Auto,Auto">
          <Button Grid.Column="1" Classes="ghost icon" x:Name="NewBlockButton" Command="{Binding NewBlockCommand}" ToolTip.Tip="{l:T NewBlockTip}" VerticalAlignment="Center" Margin="4,0,0,0">
            <controls:Icon Data="{StaticResource IconPlus}" />
          </Button>
          <ListBox x:Name="BlockList" Classes="tabs" ItemsSource="{Binding Blocks}" SelectedIndex="{Binding BlockIndex}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:ChartBlock">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Course, Converter={x:Static t:UiConverters.Difficulty}}" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
         </Grid>
        </Border>

        <ae:TextEditor Grid.Row="1" x:Name="Code" ShowLineNumbers="True" FontFamily="{StaticResource CodeFont}" FontSize="14"
                       Background="{StaticResource BaseBrush}" Foreground="#E4D9CC" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                       WordWrap="False" />

        <!-- Problems: the count is the handle that opens the list -->
        <Border Grid.Row="2" Classes="panel" BorderThickness="0,1,0,0" Height="28" Padding="6,0,6,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Classes="status" Command="{Binding ToggleProblemsCommand}" Margin="0,3">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{l:T Problems}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Problems}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <ComboBox Grid.Column="2" Classes="compact quiet" ItemsSource="{Binding MessageLanguages}" SelectedItem="{Binding MessageLanguage}"
                      Height="22" MinHeight="22" FontSize="11.5" ToolTip.Tip="{l:T MessagesTip}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock>
                    <TextBlock.Text>
                      <MultiBinding Converter="{x:Static l:Names.MessageLanguageName}">
                        <Binding />
                        <Binding Source="{x:Static loc:Loc.Instance}" Path="Language" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>
        <ListBox Grid.Row="3" x:Name="ProblemList" Classes="rows" ItemsSource="{Binding Diagnostics}" Height="140" IsVisible="{Binding ProblemListVisible}"
                 Background="{StaticResource SunkenBrush}" FontSize="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DiagnosticItem">
              <Grid ColumnDefinitions="18,64,*">
                <TextBlock Text="{Binding Icon}" Foreground="{StaticResource WarningBrush}" IsVisible="{Binding IsWarning}" />
                <TextBlock Text="{Binding Icon}" Foreground="{StaticResource InfoBrush}" IsVisible="{Binding IsInformation}" />
                <TextBlock Text="{Binding Icon}" Foreground="{StaticResource ErrorBrush}" IsVisible="{Binding IsError}" />
                <TextBlock Grid.Column="1" Text="{Binding Where}" Classes="faint" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Column="1" Classes="columns" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="2*,5,3*">
        <!-- The lane, with the route it shows in its corner -->
        <Panel>
          <controls:LaneView />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,10,0"
                      IsVisible="{Binding Analysis.HasBranches}">
            <TextBlock Classes="label" Text="{l:T Route}" VerticalAlignment="Center" />
            <ComboBox Classes="compact" ItemsSource="{Binding Routes}" SelectedItem="{Binding Route}" MinWidth="96">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="ot:BranchRoute">
                  <TextBlock>
                    <TextBlock.Text>
                      <MultiBinding Converter="{x:Static l:Names.RouteName}">
                        <Binding />
                        <Binding Source="{x:Static loc:Loc.Instance}" Path="Language" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Panel>

        <GridSplitter Grid.Row="1" Classes="rows" ResizeDirection="Rows" />

        <!-- The timeline under its tools -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
          <Border Classes="bar" Height="38" Padding="8,0,10,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Orientation="Horizontal" Spacing="10" ClipToBounds="True">
              <ListBox Classes="palette" ItemsSource="{Binding Tools}" SelectedItem="{Binding Tool}" VerticalAlignment="Center">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ToolItem">
                    <StackPanel Orientation="Horizontal" Spacing="1" ToolTip.Tip="{Binding Tip}" Background="Transparent">
                      <controls:NoteGlyph Kind="{Binding Kind}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Key}" FontSize="10" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="{Binding Tool.Label}" Classes="label" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="{l:T Grid}" VerticalAlignment="Center" />
                <ComboBox Classes="compact" ItemsSource="{Binding Divisions}" SelectedItem="{Binding Division}" MinWidth="64" />
              </StackPanel>
            </Grid>
          </Border>
          <controls:TimelineView Grid.Row="1" />
        </Grid>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Classes="panel" BorderThickness="0,1,0,0" Height="24" Padding="12,0,8,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="14">
        <TextBlock Text="{Binding FilePath}" Classes="caption" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="11.5" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Caret}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="3" x:Name="EncodingButton" Classes="status" Content="{Binding Encoding}" Margin="0,3" ToolTip.Tip="{l:T EncodingTip}" />
        <TextBlock Grid.Column="4" Text="{Binding Language.DisplayName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
