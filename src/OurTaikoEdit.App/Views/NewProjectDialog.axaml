<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OurTaikoEdit.App.Views.NewProjectDialog"
        xmlns:l="using:OurTaikoEdit.App.Localization"
        Title="{l:T NewProject}" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="footer">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="accent wide" Content="{l:T Create}" IsDefault="True" Click="Create" />
        <Button Classes="wide" Content="{l:T Cancel}" IsCancel="True" Click="Cancel" />
      </StackPanel>
    </Border>

    <StackPanel Margin="20,18,20,20" Spacing="14">
      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="{l:T NewProject}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T NewProjectIntro}" />
      </StackPanel>

      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="{l:T Name}" />
        <TextBox x:Name="NameBox" PlaceholderText="{l:T SongName}" />
      </StackPanel>

      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="{l:T Location}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="LocationBox" />
          <Button Grid.Column="1" Content="{l:T Browse}" Click="BrowseLocation" VerticalAlignment="Stretch" />
        </Grid>
        <TextBlock x:Name="FolderText" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
      </StackPanel>

      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="{l:T ChartType}" />
        <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch" />
      </StackPanel>

      <StackPanel Classes="field">
        <TextBlock Classes="label" Text="{l:T AudioOptional}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="AudioBox" PlaceholderText="song.ogg" />
          <Button Grid.Column="1" Content="{l:T Browse}" Click="BrowseAudio" VerticalAlignment="Stretch" />
        </Grid>
      </StackPanel>

      <TextBlock x:Name="ErrorText" Classes="error" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>
  </DockPanel>
</Window>
