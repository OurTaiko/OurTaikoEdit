<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OurTaikoEdit.App.App"
             xmlns:local="using:OurTaikoEdit.App"
             xmlns:t="using:OurTaikoEdit.App.Theme"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <FontFamily x:Key="CodeFont">Cascadia Code, JetBrains Mono, SF Mono, Menlo, Consolas, monospace</FontFamily>

      <!-- The palette (Theme/Ui.cs) by name. -->
      <SolidColorBrush x:Key="SunkenBrush" Color="{x:Static t:Ui.SunkenColor}" />
      <SolidColorBrush x:Key="BaseBrush" Color="{x:Static t:Ui.BaseColor}" />
      <SolidColorBrush x:Key="PanelBrush" Color="{x:Static t:Ui.PanelColor}" />
      <SolidColorBrush x:Key="RaisedBrush" Color="{x:Static t:Ui.RaisedColor}" />
      <SolidColorBrush x:Key="HoverBrush" Color="{x:Static t:Ui.HoverColor}" />
      <SolidColorBrush x:Key="ActiveBrush" Color="{x:Static t:Ui.ActiveColor}" />
      <SolidColorBrush x:Key="LineBrush" Color="{x:Static t:Ui.LineColor}" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="{x:Static t:Ui.LineStrongColor}" />
      <SolidColorBrush x:Key="PanelBorderBrush" Color="{x:Static t:Ui.LineColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{x:Static t:Ui.TextColor}" />
      <SolidColorBrush x:Key="MutedBrush" Color="{x:Static t:Ui.MutedColor}" />
      <SolidColorBrush x:Key="FaintBrush" Color="{x:Static t:Ui.FaintColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{x:Static t:Ui.AccentColor}" />
      <SolidColorBrush x:Key="AccentFillBrush" Color="{x:Static t:Ui.AccentFillColor}" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{x:Static t:Ui.AccentColor}" Opacity="0.16" />
      <SolidColorBrush x:Key="KaBrush" Color="{x:Static t:Ui.KaColor}" />
      <SolidColorBrush x:Key="KaSoftBrush" Color="{x:Static t:Ui.KaColor}" Opacity="0.16" />
      <SolidColorBrush x:Key="WarningBrush" Color="{x:Static t:Ui.WarningColor}" />
      <SolidColorBrush x:Key="ErrorBrush" Color="{x:Static t:Ui.ErrorColor}" />
      <SolidColorBrush x:Key="InfoBrush" Color="{x:Static t:Ui.InfoColor}" />

      <!-- The Fluent controls in those colours. -->
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
      <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>

      <StaticResource x:Key="ButtonBackground" ResourceKey="RaisedBrush" />
      <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="HoverBrush" />
      <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ActiveBrush" />
      <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="PanelBrush" />
      <StaticResource x:Key="ButtonBorderBrush" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="LineBrush" />
      <StaticResource x:Key="ButtonForeground" ResourceKey="TextBrush" />
      <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextBrush" />
      <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextBrush" />
      <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="FaintBrush" />
      <Thickness x:Key="ButtonPadding">12,5,12,6</Thickness>

      <StaticResource x:Key="AccentButtonBackground" ResourceKey="AccentFillBrush" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E64838" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#BF3024" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />

      <StaticResource x:Key="ToggleButtonBackground" ResourceKey="RaisedBrush" />
      <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="HoverBrush" />
      <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="ActiveBrush" />
      <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="LineStrongBrush" />

      <StaticResource x:Key="TextControlBackground" ResourceKey="SunkenBrush" />
      <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SunkenBrush" />
      <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SunkenBrush" />
      <StaticResource x:Key="TextControlBorderBrush" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="FaintBrush" />
      <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="KaBrush" />
      <StaticResource x:Key="TextControlForeground" ResourceKey="TextBrush" />
      <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextBrush" />
      <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextBrush" />
      <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="FaintBrush" />
      <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="FaintBrush" />
      <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="FaintBrush" />
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#2C6E76" />

      <StaticResource x:Key="ComboBoxBackground" ResourceKey="RaisedBrush" />
      <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="HoverBrush" />
      <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="ActiveBrush" />
      <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="RaisedBrush" />
      <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="MutedBrush" />
      <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="HoverBrush" />
      <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="ActiveBrush" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="ActiveBrush" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="ActiveBrush" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="ActiveBrush" />

      <StaticResource x:Key="SliderTrackFill" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush" />
      <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentBrush" />
      <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentBrush" />
      <StaticResource x:Key="SliderThumbBackground" ResourceKey="TextBrush" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
      <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="MutedBrush" />
      <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
      <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>

      <StaticResource x:Key="ToolTipBackground" ResourceKey="RaisedBrush" />
      <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="ToolTipForeground" ResourceKey="TextBrush" />
      <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="RaisedBrush" />
      <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="LineStrongBrush" />
      <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="HoverBrush" />
      <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="ActiveBrush" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- The theme's own greys warmed to the palette, so what is not styled by hand still belongs. -->
        <ColorPaletteResources x:Key="Dark"
                               Accent="{x:Static t:Ui.AccentFillColor}"
                               RegionColor="{x:Static t:Ui.BaseColor}"
                               ErrorText="{x:Static t:Ui.ErrorColor}"
                               AltHigh="{x:Static t:Ui.SunkenColor}" AltLow="#33151110" AltMedium="#99151110" AltMediumHigh="#CC151110" AltMediumLow="#66151110"
                               BaseHigh="{x:Static t:Ui.TextColor}" BaseLow="#33F3E9DC" BaseMedium="#99F3E9DC" BaseMediumHigh="#CCF3E9DC" BaseMediumLow="#66F3E9DC"
                               ChromeAltLow="#D6C9BC" ChromeBlackHigh="#FF000000" ChromeBlackLow="#33000000" ChromeBlackMedium="#CC000000" ChromeBlackMediumLow="#66000000"
                               ChromeDisabledHigh="{x:Static t:Ui.HoverColor}" ChromeDisabledLow="{x:Static t:Ui.FaintColor}"
                               ChromeGray="{x:Static t:Ui.FaintColor}" ChromeHigh="{x:Static t:Ui.FaintColor}"
                               ChromeLow="{x:Static t:Ui.SunkenColor}" ChromeMedium="{x:Static t:Ui.PanelColor}" ChromeMediumLow="{x:Static t:Ui.RaisedColor}"
                               ChromeWhite="#FFFFFFFF" ListLow="#19F3E9DC" ListMedium="#33F3E9DC" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
