<Project Sdk="Microsoft.NET.Sdk">
  <!-- Song audio: decoding (OGG, MP3, WAV) to PCM, a waveform, and playback through OpenAL Soft. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="NLayer" Version="3.0.1" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- The game's hit sounds, next to the program (HitSoundSets). -->
    <None Include="HitSounds\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
