<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CharTaiko.App.ViewModels"
             xmlns:l="using:CharTaiko.App.Localization"
             x:Class="CharTaiko.App.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">
  <Grid RowDefinitions="Auto,*" Margin="32,24">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      <StackPanel Spacing="4">
        <TextBlock Text="CharTaiko" FontSize="28" FontWeight="Bold" />
        <TextBlock Classes="muted" Text="{l:T Projects}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="accent" Content="{l:T NewProjectMenu}" Command="{Binding NewProjectCommand}" />
        <Button Content="{l:T OpenFolderMenu}" Command="{Binding OpenFolderCommand}" />
        <Button Content="{l:T SettingsMenu}" Command="{Binding SettingsCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
      <TextBlock HorizontalAlignment="Center" FontSize="18" Text="{l:T NoProjects}" />
      <TextBlock Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                 Text="{l:T NoProjectsHint}" />
    </StackPanel>

    <ListBox Grid.Row="1" x:Name="List" ItemsSource="{Binding Projects}" SelectedItem="{Binding Selected}"
             Background="Transparent" IsVisible="{Binding !IsEmpty}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ProjectItemViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="4,8" Background="Transparent">
            <Border Width="44" Height="44" CornerRadius="22" Background="#FF6A4D" VerticalAlignment="Center">
              <TextBlock Text="{Binding ChartType}" FontSize="11" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Problem}" Foreground="#FF6A4D" IsVisible="{Binding HasProblem}" />
              <TextBlock Classes="muted" FontSize="12" Text="{Binding Folder}" TextTrimming="PathSegmentEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Classes="muted" FontSize="12" Text="{Binding LastOpened}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Content="{l:T Open}" Command="{Binding $parent[ListBox].((vm:ProjectsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}" />
              <Button Content="{l:T Remove}" Command="{Binding $parent[ListBox].((vm:ProjectsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
