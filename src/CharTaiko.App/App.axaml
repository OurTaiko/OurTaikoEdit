<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CharTaiko.App.App"
             xmlns:local="using:CharTaiko.App"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <FontFamily x:Key="CodeFont">Cascadia Code, JetBrains Mono, Menlo, Consolas, monospace</FontFamily>
    <SolidColorBrush x:Key="PanelBrush" Color="#202124" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#33363B" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF6A4D" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.toolbar">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="ToggleButton.tool">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
